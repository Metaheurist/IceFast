{
  "name": "icefast",
  "private": false,
  "version": "1.0.0",
  "description": "Open-source cold-chain warehouse companion - floor sheets, dispatch, yard temps, on-device OCR",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "db:build": "node scripts/build-demo-db.mjs",
    "ocr:sync": "node scripts/sync-ocr-assets.mjs",
    "predev": "npm run db:build && npm run ocr:sync",
    "dev": "vite",
    "prebuild": "npm run db:build && npm run ocr:sync",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run db:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.8",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
